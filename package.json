{
  "name": "deepblock",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:convex": "vitest run --config vitest.convex.config.ts",
    "test:crawl": "playwright test e2e/crawl.spec.ts --reporter=line",
    "test:crawl:watch": "playwright test e2e/crawl.spec.ts --headed --reporter=line",
    "test:crawl:ui": "playwright test e2e/crawl.spec.ts --ui",
    "test:e2e": "playwright test --reporter=line",
    "test:e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "@convex-dev/auth": "^0.0.92",
    "@types/leaflet": "^1.9.21",
    "convex": "^1.38.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.16.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-leaflet": "^5.0.0",
    "react-router-dom": "^7.13.1"
  },
  "devDependencies": {
    "@edge-runtime/vm": "^5.0.0",
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.60.0",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "autoprefixer": "^10.4.27",
    "convex-test": "^0.0.53",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.19",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.48.0",
    "vite": "^7.3.1",
    "vitest": "^4.1.6"
  }
}
